{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "target": "ES2020",
    "useDefineForClassFields": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"],
      "@pages/*": ["./src/pages/*"],
      "@store/*": ["./src/store/*"],
      "@assets/*": ["./src/assets/*"],
      "@editor/*": ["./src/features/editor-runtime/*"],
      "@editor-components/*": ["./src/features/editor-runtime/components/*"],
      "@editor-hooks/*": ["./src/features/editor-runtime/hooks/*"],
      "@sim-config/*": ["./src/features/simulation-config/*"],
      "@sim-config-utils/*": ["./src/features/simulation-config/utils/*"],
      "@scenario-export": ["./src/features/scenario-export/index.ts"],
      "@scenario-export/*": ["./src/features/scenario-export/*"],
      "@right-panel/*": ["./src/widgets/RightPanel/*"],
      "@widgets/*": ["./src/widgets/*"]
    }
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["vitest.config.ts", "node_modules"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
