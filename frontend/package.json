{
  "name": "scenario-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --headed",
    "lint": "eslint . --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:css": "stylelint \"src/**/*.{css,scss,sass}\" --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "analyze": "vite build --mode analyze",
    "build:analyze": "vite build --mode analyze",
    "ci": "yarn lint && yarn test && yarn build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/system": "9.5.0",
    "@mui/x-tree-view": "9.16.0",
    "@tanstack/react-query": "^5.91.0",
    "ky": "^1.14.3",
    "notyf": "^3.10.0",
    "react": "19.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "19.3.1",
    "react-number-format": "^5.3.3",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16",
    "three-stdlib": "2.36.1",
    "zustand": "^5.0.3"
  },
  "resolutions": {
    "vitest/vite": "8.3.5",
    "eslint-plugin-react-hooks/zod": "4.6.6",
    "stylelint/colord": "2.10.0",
    "eslint/minimatch/brace-expansion": "1.1.21",
    "@eslint/config-array/minimatch/brace-expansion": "1.1.21",
    "@typescript-eslint/**/minimatch/brace-expansion": "5.0.12",
    "jsdom/undici": "7.30.1",
    "stylelint/**/fast-uri": "3.1.9",
    "**/js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "postcss": "8.5.31",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "1.103.0",
    "stylelint": "^17.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "4.1.12"
  }
}
